TORRENT_STORAGE_ENDPOINT=https://endpoint.domain/api/torrents
BOOTSTRAP=router.utorrent.com:6881,router.bitcomet.com:6881,router.bittorrent.com:6881,dht.transmissionbt.com:6881
TORRENT_DIR=./torrent
URL_TRACKER_LIST=https://raw.githubusercontent.com/ngosang/trackerslist/master/trackers_best.txt
RESUME_SAVE_TIMEOUT=30
METADATA_QUEUE_SIZE=20
METADATA_DRAIN_TIMEOUT=30
MAX_TORRENTS=100
TORRENT_TTL=600
STATUS_RENDER_INTERVAL=1.0
STATUS_UPDATE_INTERVAL=2.0
# Management HTTP is enabled on loopback by default (127.0.0.1:8080) so the
# local CLI works without extra configuration. Set MANAGEMENT_PORT=0 to
# disable it. Non-loopback binds require MANAGEMENT_TOKEN and
# --management-allow-remote. See README for security details.
MANAGEMENT_HOST=127.0.0.1
MANAGEMENT_PORT=8080
# Sniff-mode scheduler bounds (only active in sniff mode, not download mode).
# These control how many concurrent metadata acquisitions are in flight,
# how many candidates wait in queue, how fast new acquisitions start, and
# how failures back off. See README for details.
SNIFF_MAX_QUEUE=64
SNIFF_MAX_IN_FLIGHT=4
SNIFF_MAX_STARTS_PER_SECOND=1.0
SNIFF_START_RATE_WINDOW=1.0
SNIFF_ACQUISITION_TIMEOUT=120.0
SNIFF_QUEUE_WAIT_TIMEOUT=300.0
SNIFF_COOLDOWN_BASE=30.0
SNIFF_COOLDOWN_MAX=3600.0
SNIFF_COOLDOWN_MULTIPLIER=2.0
SNIFF_COOLDOWN_JITTER=0.25
SNIFF_MAX_COOLDOWNS=512
SNIFF_COOLDOWN_TTL=7200.0
SNIFF_DIAGNOSTICS_INTERVAL=60.0
SNIFF_DISTINCT_HASH_BUDGET=256
SNIFF_MAX_CANDIDATES=2048
SNIFF_PERSIST_RESULT_CAPACITY=256
SNIFF_QUEUE_DROP_COOLDOWN=30.0
