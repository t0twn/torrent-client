TORRENT_STORAGE_ENDPOINT=https://endpoint.domain/api/torrents
BOOTSTRAP=router.utorrent.com:6881,router.bitcomet.com:6881,router.bittorrent.com:6881,dht.transmissionbt.com:6881
TORRENT_DIR=./torrent
URL_TRACKER_LIST=https://raw.githubusercontent.com/ngosang/trackerslist/master/trackers_best.txt
RESUME_SAVE_TIMEOUT=30
METADATA_QUEUE_SIZE=20
METADATA_DRAIN_TIMEOUT=30
MAX_TORRENTS=100
TORRENT_TTL=600
STATUS_RENDER_INTERVAL=1.0
STATUS_UPDATE_INTERVAL=2.0
# Management HTTP is intentionally disabled by default. When enabled, set
# MANAGEMENT_TOKEN in env/override.env rather than committing it here.
MANAGEMENT_HOST=127.0.0.1
MANAGEMENT_PORT=0
